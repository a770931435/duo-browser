<?xml version="1.0" encoding="utf-8"?>
<!--
  前景：RP Duo 的上下兩塊機身（紫透色殼、邊緣是飽和紫），
  螢幕裡是一顆發光的地球（網頁），被轉軸切成上下兩半——一個網頁跨兩個螢幕。
  整組縮到 0.8 倍，圓形遮罩也不會切到機身的角。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group android:scaleX="0.8" android:scaleY="0.8" android:pivotX="54" android:pivotY="55">

    <!-- 機身後面的柔光 -->
    <path android:pathData="M54,55m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="55" android:gradientRadius="40">
                <item android:offset="0" android:color="#55A983E8" />
                <item android:offset="1" android:color="#00A983E8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 上機身（紫透色殼） -->
    <path android:pathData="M30,23h48a5,5 0,0 1,5 5v20a5,5 0,0 1,-5 5h-48a5,5 0,0 1,-5 -5v-20a5,5 0,0 1,5 -5z"
        android:strokeColor="#FFC7A8FF" android:strokeWidth="1.2">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="25" android:startY="23" android:endX="83" android:endY="53">
                <item android:offset="0" android:color="#F2E3D8FF" />
                <item android:offset="0.5" android:color="#E6B9A2EE" />
                <item android:offset="1" android:color="#D98C6BD6" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 下機身（比上面窄一點） -->
    <path android:pathData="M33,56.5h42a5,5 0,0 1,5 5v20.5a5,5 0,0 1,-5 5h-42a5,5 0,0 1,-5 -5v-20.5a5,5 0,0 1,5 -5z"
        android:strokeColor="#FFC7A8FF" android:strokeWidth="1.2">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="28" android:startY="56" android:endX="80" android:endY="87">
                <item android:offset="0" android:color="#F2DCCFFF" />
                <item android:offset="0.5" android:color="#E6B39AEC" />
                <item android:offset="1" android:color="#D9805FCE" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 轉軸 -->
    <path android:fillColor="#FF6B58A0" android:pathData="M36,53h36v3.5h-36z" />

    <!-- 上螢幕：深色玻璃，靠轉軸那邊有紫光 -->
    <path android:pathData="M31.5,26.5h45a2.5,2.5 0,0 1,2.5 2.5v18a2.5,2.5 0,0 1,-2.5 2.5h-45a2.5,2.5 0,0 1,-2.5 -2.5v-18a2.5,2.5 0,0 1,2.5 -2.5z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="34">
                <item android:offset="0" android:color="#FF4A3478" />
                <item android:offset="1" android:color="#FF110C1C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 下螢幕 -->
    <path android:pathData="M37.5,60h33a2,2 0,0 1,2 2v14.5a2,2 0,0 1,-2 2h-33a2,2 0,0 1,-2 -2v-14.5a2,2 0,0 1,2 -2z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="30">
                <item android:offset="0" android:color="#FF4A3478" />
                <item android:offset="1" android:color="#FF110C1C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 地球：上半在上螢幕裡 -->
    <group>
        <clip-path android:pathData="M31.5,26.5h45a2.5,2.5 0,0 1,2.5 2.5v18a2.5,2.5 0,0 1,-2.5 2.5h-45a2.5,2.5 0,0 1,-2.5 -2.5v-18a2.5,2.5 0,0 1,2.5 -2.5z" />
        <path android:strokeColor="#FFF4EEFF" android:strokeWidth="1.8" android:fillColor="#00000000"
            android:pathData="M54,54m-19,0a19,19 0,1 1,38 0a19,19 0,1 1,-38 0" />
        <path android:strokeColor="#FFD6C4FF" android:strokeWidth="1.3" android:fillColor="#00000000"
            android:pathData="M54,54m-8,0a8,19 0,1 1,16 0a8,19 0,1 1,-16 0M54,35v38M38.5,43.5h31" />
    </group>
    <!-- 地球：下半在下螢幕裡（轉軸那段看不到，像真的跨過去） -->
    <group>
        <clip-path android:pathData="M37.5,60h33a2,2 0,0 1,2 2v14.5a2,2 0,0 1,-2 2h-33a2,2 0,0 1,-2 -2v-14.5a2,2 0,0 1,2 -2z" />
        <path android:strokeColor="#FFF4EEFF" android:strokeWidth="1.8" android:fillColor="#00000000"
            android:pathData="M54,54m-19,0a19,19 0,1 1,38 0a19,19 0,1 1,-38 0" />
        <path android:strokeColor="#FFD6C4FF" android:strokeWidth="1.3" android:fillColor="#00000000"
            android:pathData="M54,54m-8,0a8,19 0,1 1,16 0a8,19 0,1 1,-16 0M54,35v38M38.5,64.5h31" />
    </group>

    <!-- 下機身兩側的按鍵：左十字鍵、右按鈕 -->
    <path android:fillColor="#FF4E3D78" android:pathData="M30.4,66.3h1.7v-1.7h1.5v1.7h1.7v1.5h-1.7v1.7h-1.5v-1.7h-1.7z" />
    <path android:fillColor="#FF4E3D78" android:pathData="M75.8,66.5m-1.2,0a1.2,1.2 0,1 1,2.4 0a1.2,1.2 0,1 1,-2.4 0M75.8,70.6m-1.2,0a1.2,1.2 0,1 1,2.4 0a1.2,1.2 0,1 1,-2.4 0" />

    <!-- 機殼上緣的反光 -->
    <path android:fillColor="#80FFFFFF" android:pathData="M31,24.1h46a0.6,0.6 0,0 1,0 1.2h-46a0.6,0.6 0,0 1,0 -1.2z" />
    <path android:fillColor="#66FFFFFF" android:pathData="M34,57.6h40a0.6,0.6 0,0 1,0 1.1h-40a0.6,0.6 0,0 1,0 -1.1z" />
  </group>
</vector>
